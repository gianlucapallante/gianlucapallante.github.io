{% comment %}
  GitHub user card built from the profile avatar and shields.io badges (the
  public github-readme-stats service this used to rely on is no longer
  reliably available).
{% endcomment %}
{% assign badge_style = 'style=flat-square' %}

<div class="repo p-2">
  <div class="repo-card repo-user-card">
    <a href="https://github.com/{{ include.username }}" class="repo-user-avatar">
      <img src="https://github.com/{{ include.username }}.png?size=128" alt="{{ include.username }} on GitHub" loading="lazy">
    </a>
    <div>
      <a class="repo-card-title" href="https://github.com/{{ include.username }}">
        <i class="fa-brands fa-github" aria-hidden="true"></i>
        {{ include.username }}
      </a>
      <div class="repo-card-badges">
        <img alt="Followers" src="https://img.shields.io/github/followers/{{ include.username }}?{{ badge_style }}&logo=github&label=followers" loading="lazy">
        <img alt="Total stars" src="https://img.shields.io/github/stars/{{ include.username }}?{{ badge_style }}&logo=github&label=total%20stars" loading="lazy">
      </div>
    </div>
  </div>
</div>
