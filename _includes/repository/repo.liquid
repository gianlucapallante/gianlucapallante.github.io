{% comment %}
  Repository card built from shields.io badges (the public github-readme-stats
  service this used to rely on is no longer reliably available).
{% endcomment %}
{% assign repo_url = include.repository | split: '/' %}
{% assign owner = repo_url[0] %}
{% assign name = repo_url[1] %}
{% if site.data.repositories.github_users contains owner %}
  {% assign display_name = name %}
{% else %}
  {% assign display_name = include.repository %}
{% endif %}
{% assign badge_style = 'style=flat-square' %}

<div class="repo p-2">
  <div class="repo-card">
    <a class="repo-card-title" href="https://github.com/{{ include.repository }}">
      <i class="fa-brands fa-github" aria-hidden="true"></i>
      {{ display_name }}
    </a>
    <div class="repo-card-badges">
      <img alt="Stars" src="https://img.shields.io/github/stars/{{ include.repository }}?{{ badge_style }}&logo=github&label=stars" loading="lazy">
      <img alt="Forks" src="https://img.shields.io/github/forks/{{ include.repository }}?{{ badge_style }}&logo=github&label=forks" loading="lazy">
      <img alt="Top language" src="https://img.shields.io/github/languages/top/{{ include.repository }}?{{ badge_style }}" loading="lazy">
      <img alt="Last commit" src="https://img.shields.io/github/last-commit/{{ include.repository }}?{{ badge_style }}&label=updated" loading="lazy">
    </div>
  </div>
</div>
